# Embeds SQL migration scripts into a generated C++ header.
#
#   noteman_embed_migrations(
#       DIRECTORY <dir containing NNN_name.sql files>
#       OUTPUT    <generated header path>)
#
# Each file must be named NNN_name.sql (e.g. 003_permissions_blobs_versions.sql).
# Versions must be sequential starting at 1. The header defines
# noteman::db::generated::kMigrationScripts, ordered by version.
#
# Runs at configure time. Every script is registered as a configure
# dependency, so editing or adding a .sql file re-runs CMake on the next build.

function(noteman_embed_migrations)
    cmake_parse_arguments(ARG "" "DIRECTORY;OUTPUT" "" ${ARGN})
    if(NOT ARG_DIRECTORY OR NOT ARG_OUTPUT)
        message(FATAL_ERROR "noteman_embed_migrations: DIRECTORY and OUTPUT are required")
    endif()

    file(GLOB sql_files CONFIGURE_DEPENDS "${ARG_DIRECTORY}/*.sql")
    list(SORT sql_files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${sql_files})

    set(delimiter "__nm_sql__")
    set(entries "")
    set(expected_version 1)

    foreach(sql_file IN LISTS sql_files)
        get_filename_component(file_name "${sql_file}" NAME)
        get_filename_component(name "${sql_file}" NAME_WE)

        if(NOT file_name MATCHES "^([0-9]+)_[A-Za-z0-9_]+\\.sql$")
            message(FATAL_ERROR "Migration '${file_name}' must be named NNN_name.sql")
        endif()
        math(EXPR version "${CMAKE_MATCH_1}")
        if(NOT version EQUAL expected_version)
            message(FATAL_ERROR
                "Migration '${file_name}' has version ${version}, expected ${expected_version} "
                "(versions must be sequential)")
        endif()
        math(EXPR expected_version "${expected_version} + 1")

        file(READ "${sql_file}" sql)
        string(FIND "${sql}" ")${delimiter}\"" clash)
        if(NOT clash EQUAL -1)
            message(FATAL_ERROR "Migration '${file_name}' contains the raw-string delimiter")
        endif()

        string(APPEND entries
            "    {${version}, \"${name}\",\n"
            "     R\"${delimiter}(${sql})${delimiter}\"},\n")
    endforeach()

    if(entries STREQUAL "")
        message(FATAL_ERROR "No migrations found in ${ARG_DIRECTORY}")
    endif()

    set(content
"// GENERATED by cmake/EmbedMigrations.cmake from src/database/sql/migrations/.
// Do not edit: change the .sql files instead.
#pragma once

namespace noteman::db::generated {

struct MigrationScript {
    int version;
    const char *name;
    const char *sql;
};

inline constexpr MigrationScript kMigrationScripts[] = {
${entries}};

} // namespace noteman::db::generated
")

    # Write via a temp file so the header (and its dependents) are only
    # touched when the content actually changes.
    file(WRITE "${ARG_OUTPUT}.tmp" "${content}")
    configure_file("${ARG_OUTPUT}.tmp" "${ARG_OUTPUT}" COPYONLY)
    file(REMOVE "${ARG_OUTPUT}.tmp")
endfunction()
