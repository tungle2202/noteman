Project Noteman {
  database_type: 'SQLite 3'
  Note: '''
    Pragmas: foreign_keys = ON, journal_mode = WAL, synchronous = NORMAL.
    Migration strategy: PRAGMA user_version + _migrations audit log (current schema version: 3).

    Conventions:
    - All timestamps: ISO 8601 UTC, fixed format, generated by strftime('%Y-%m-%dT%H:%M:%fZ','now')
      Example: 2026-11-25T04:35:12.345Z
    - Permission mode: 6-bit INTEGER, 2 bits (read, write) per class:
        bit 5 = owner r (32), bit 4 = owner w (16)
        bit 3 = group r (8),  bit 2 = group w (4)
        bit 1 = other r (2),  bit 0 = other w (1)
      Default: rw---- (owner rw, group none, other none).
      Check order: owner -> group -> other; only the first matching class applies.
    - Threads, notes, quotes and tasks inherit permissions from their subject.
    - Binary content (PDF, images) lives on disk in a content-addressed store:
        data/blobs/{hash[0:2]}/{hash[2:]}   (SHA-256 hex, written once, never modified)
      Text notes (.md, .tex) are versioned inside the database (note_versions).
    - Touch triggers: UPDATE on notes/quotes/tasks bubbles last_update up to threads and subjects.
  '''
}

// ---------------------------------------------------------------------------
// Identity & groups
// ---------------------------------------------------------------------------

Table users {
  id TEXT [pk, not null, note: 'Unique user identifier (UUID v4).']
  username TEXT [unique, not null, note: 'Unique login username or handle. Example: tung_le']
  email TEXT [unique, note: 'User email address.']
  password_hash TEXT [note: '''
    Argon2id hash in PHC string format (libsodium crypto_pwhash_str), salt and cost
    parameters are embedded in the string. Null if password left blank.
  ''']
  primary_group_id TEXT [not null, note: 'Foreign key referencing groups(id). Default group for new subjects.']
  is_admin INTEGER [not null, default: 0, note: 'Boolean (CHECK IN (0, 1)). 1 = bypasses permission checks (root-like).']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`, note: 'ISO 8601 UTC.']

  Note: 'User accounts. Each user belongs to one primary group and optionally more via user_groups.'
}

Table groups {
  id TEXT [pk, not null, note: 'Unique group identifier (UUID v4).']
  name TEXT [unique, not null, note: 'Group name. Example: nhom_IT3080_20261']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  Note: 'Groups used by the group permission class (like /etc/group).'
}

Table user_groups {
  user_id TEXT [not null, note: 'Foreign key referencing users(id).']
  group_id TEXT [not null, note: 'Foreign key referencing groups(id).']

  indexes {
    (user_id, group_id) [pk]
    group_id [name: 'idx_user_groups_group_id']
  }

  Note: 'Supplementary group membership (a user can be in many groups). The primary group is also inserted here so permission queries only need this table.'
}

// ---------------------------------------------------------------------------
// Workspace hierarchy: subject -> thread -> notes / quotes / tasks
// ---------------------------------------------------------------------------

Table subjects {
  id TEXT [pk, not null, note: 'Unique subject identifier (UUID v4). Course code moved to `code`.']
  code TEXT [not null, note: 'Course code. Example: IT3080']
  name TEXT [not null, note: 'Human-readable subject name. Example: Mạng máy tính']
  semester TEXT [not null, note: 'Academic semester code. Example: 20261']
  owner_id TEXT [not null, note: 'Foreign key referencing users(id). Owner permission class.']
  group_id TEXT [not null, note: 'Foreign key referencing groups(id). Group permission class.']
  mode INTEGER [not null, default: 56, note: '6-bit permission mask (see project note). CHECK (mode BETWEEN 0 AND 63).']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]
  last_update TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`, note: 'Touched when anything inside the subject changes.']

  indexes {
    (owner_id, code, semester) [unique, name: 'uq_subjects_owner_code_semester']
    owner_id [name: 'idx_subjects_owner_id']
    group_id [name: 'idx_subjects_group_id']
  }

  Note: '''
    Academic subjects/courses. Unit of permission (owner / group / other, read / write).
    Visible-subjects query for user :uid:
      owner_id = :uid AND (mode & 32)
      OR (owner_id != :uid AND group_id IN (SELECT group_id FROM user_groups WHERE user_id = :uid) AND (mode & 8))
      OR (owner_id != :uid AND group_id NOT IN (...same...) AND (mode & 2))
  '''
}

Table threads {
  id TEXT [pk, not null, note: 'Unique thread identifier (UUID v4).']
  subject_id TEXT [not null, note: 'Foreign key referencing subjects(id).']
  title TEXT [not null, note: 'Thread or lesson topic title. Example: Buổi 2: Rust và Tauri']
  description TEXT [note: 'Short summary of the lesson covered in this thread.']
  created_by TEXT [note: 'Foreign key referencing users(id).']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]
  last_update TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  indexes {
    subject_id [name: 'idx_threads_subject_id']
  }

  Note: 'Study threads under a subject. Permissions inherited from the subject.'
}

// ---------------------------------------------------------------------------
// Binary content store (PDF materials, media)
// ---------------------------------------------------------------------------

Table blobs {
  hash TEXT [pk, not null, note: 'SHA-256 hex of the file content. Physical path derived: data/blobs/{hash[0:2]}/{hash[2:]}']
  size INTEGER [not null, note: 'Size in bytes.']
  mime_type TEXT [not null, note: 'Example: application/pdf, image/png']
  page_count INTEGER [note: 'For PDFs: number of pages, cached at import.']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  Note: '''
    Immutable, deduplicated content. The same PDF imported into several subjects is stored once.
    No refcount column: garbage collection deletes blobs not referenced by any row in materials:
      DELETE FROM blobs WHERE hash NOT IN (SELECT blob_hash FROM materials);
  '''
}

Table materials {
  id TEXT [pk, not null, note: 'Unique material identifier (UUID v4).']
  subject_id TEXT [not null, note: 'Foreign key referencing subjects(id). Shown in the Material tab of the subject.']
  blob_hash TEXT [not null, note: 'Foreign key referencing blobs(hash).']
  display_name TEXT [not null, note: 'Original file name shown to the user. Example: GiaoTrinh_MangMayTinh.pdf']
  uploaded_by TEXT [note: 'Foreign key referencing users(id). Audit: who imported it.']
  uploaded_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]
  deleted_at TEXT [note: 'Soft delete. Hidden from the Material tab, quotes still resolve while it is set.']

  indexes {
    subject_id [name: 'idx_materials_subject_id']
    blob_hash [name: 'idx_materials_blob_hash']
    (subject_id, blob_hash) [unique, name: 'uq_materials_subject_blob']
  }

  Note: 'Imported course materials (read-only PDFs). Logical reference to an immutable blob.'
}

// ---------------------------------------------------------------------------
// PDF quoting & reading progress (replaces the two per-PDF metadata files)
// ---------------------------------------------------------------------------

Table quotes {
  id TEXT [pk, not null, note: 'Unique quote identifier (UUID v4).']
  thread_id TEXT [not null, note: 'Foreign key referencing threads(id). Thread the quote is shown in.']
  material_id TEXT [not null, note: 'Foreign key referencing materials(id). Source PDF (may belong to another subject).']
  kind TEXT [not null, note: "CHECK IN ('full', 'pages', 'region', 'text').  full = whole file."]
  spec_json TEXT [not null, note: '''
    Location inside the PDF in PDF user-space units (points), never pixels. Example:
    {"regions":[{"page":42,"rect":[72.0,410.5,523.0,612.0]},
                {"page":43,"rect":[72.0,680.0,523.0,760.0]}]}
    For kind = pages: {"from":10,"to":15}. For kind = full: {}.
  ''']
  extracted_text TEXT [note: 'Plain text of the quoted part, for search and preview without rendering.']
  note TEXT [note: 'User comment attached to the quote.']
  author_id TEXT [note: 'Foreign key referencing users(id).']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]
  last_update TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  indexes {
    thread_id [name: 'idx_quotes_thread_id']
    material_id [name: 'idx_quotes_material_id', note: 'Reverse lookup: where is this PDF quoted?']
  }

  Note: '''
    A quote never copies the PDF; the viewer renders the regions from the source blob.
    Cross-subject rule (decide once, enforce in canAccess): viewer must have read on the source subject,
    OR reading the thread is enough to see the quoted part (but not open the full material).
  '''
}

Table reading_progress {
  user_id TEXT [not null, note: 'Foreign key referencing users(id).']
  material_id TEXT [not null, note: 'Foreign key referencing materials(id).']
  page INTEGER [not null, note: '1-based page number.']
  page_offset REAL [not null, default: 0, note: 'Relative position within the page, 0.0 (top) .. 1.0 (bottom). Independent of window size.']
  zoom REAL [note: 'Last zoom factor. Example: 1.25']
  updated_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  indexes {
    (user_id, material_id) [pk]
  }

  Note: 'Per-user last reading position (private, never shared). Written on close / tab switch and debounced (2-5 s) while scrolling. UPSERT with ON CONFLICT DO UPDATE.'
}

// ---------------------------------------------------------------------------
// Text notes (.md, .tex) with Git-like version history
// ---------------------------------------------------------------------------

Table notes {
  id TEXT [pk, not null, note: 'Unique note identifier (UUID v4).']
  thread_id TEXT [not null, note: 'Foreign key referencing threads(id).']
  file_name TEXT [not null, note: 'File name with extension. Example: buoi2_notes.md']
  format TEXT [not null, note: "CHECK IN ('md', 'tex')."]
  current_version_id TEXT [note: 'Foreign key referencing note_versions(id), DEFERRABLE INITIALLY DEFERRED (note and first version are inserted in one transaction).']
  created_by TEXT [note: 'Foreign key referencing users(id).']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]
  last_update TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  indexes {
    thread_id [name: 'idx_notes_thread_id']
    (thread_id, file_name) [unique, name: 'uq_notes_thread_file_name']
  }

  Note: '''
    User-written notes. Content lives in note_versions; this row points to the current one.
    Optimistic concurrency on save: UPDATE notes SET current_version_id = :new
      WHERE id = :id AND current_version_id = :parent;
    0 rows changed -> someone saved first -> 3-way merge (parent, current, mine) or report conflict.
  '''
}

Table note_versions {
  id TEXT [pk, not null, note: 'Unique version identifier (UUID v4).']
  note_id TEXT [not null, note: 'Foreign key referencing notes(id).']
  parent_id TEXT [note: 'Foreign key referencing note_versions(id). Version this one was edited from (null for the first). Base for 3-way merge.']
  author_id TEXT [note: 'Foreign key referencing users(id). Used for history and line-level blame.']
  content BLOB [not null, note: 'Full snapshot of the text, compressed according to `compression`.']
  compression TEXT [not null, default: 'zstd', note: "CHECK IN ('none', 'zstd')."]
  content_hash TEXT [not null, note: 'SHA-256 of the uncompressed text. Skip saving if equal to the current version.']
  size INTEGER [not null, note: 'Uncompressed size in bytes.']
  message TEXT [note: "Optional message. Example: 'Khôi phục từ version #12'"]
  pinned INTEGER [not null, default: 0, note: 'Boolean (CHECK IN (0, 1)). Pinned versions are never removed by retention.']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  indexes {
    (note_id, created_at) [name: 'idx_note_versions_note_created']
    content_hash [name: 'idx_note_versions_content_hash']
  }

  Note: '''
    Version history (snapshot per version, like Git blobs).
    - Rollback = insert a new version with the old content (history is kept, rollback has an author).
    - Autosave coalescing: same author within ~10 minutes overwrites the latest unpinned version.
    - Retention (optional): keep all for 30 days, then thin out; pinned rows are kept.
  '''
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

Table tasks {
  id TEXT [pk, not null, note: 'Unique task identifier (UUID v4).']
  thread_id TEXT [not null, note: 'Foreign key referencing threads(id).']
  title TEXT [not null, note: 'Title or summary of the task.']
  deadline TEXT [note: 'ISO 8601 UTC timestamp, or date only (YYYY-MM-DD) for all-day deadlines.']
  completed_at TEXT [note: 'ISO 8601 UTC. Null = not done.']
  created_by TEXT [note: 'Foreign key referencing users(id).']
  created_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]
  last_update TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  indexes {
    thread_id [name: 'idx_tasks_thread_id']
    deadline [name: 'idx_tasks_deadline']
  }

  Note: 'Actionable tasks and homework deadlines linked to study threads.'
}

// ---------------------------------------------------------------------------
// Migrations
// ---------------------------------------------------------------------------

Table _migrations {
  version INTEGER [pk, not null, note: 'Sequential migration version number matching PRAGMA user_version.']
  name TEXT [not null, note: 'Human-readable migration identifier. Example: 003_permissions_blobs_versions']
  applied_at TEXT [not null, default: `strftime('%Y-%m-%dT%H:%M:%fZ','now')`]

  Note: 'Internal audit log of sequentially applied schema migrations.'
}

// ---------------------------------------------------------------------------
// Foreign Keys & Referential Actions
// ---------------------------------------------------------------------------

Ref: users.primary_group_id > groups.id [delete: restrict]
Ref: user_groups.user_id > users.id [delete: cascade]
Ref: user_groups.group_id > groups.id [delete: cascade]

Ref: subjects.owner_id > users.id [delete: restrict]
Ref: subjects.group_id > groups.id [delete: restrict]

Ref: threads.subject_id > subjects.id [delete: cascade]
Ref: threads.created_by > users.id [delete: set null]

Ref: materials.subject_id > subjects.id [delete: cascade]
Ref: materials.blob_hash > blobs.hash [delete: restrict]
Ref: materials.uploaded_by > users.id [delete: set null]

Ref: quotes.thread_id > threads.id [delete: cascade]
Ref: quotes.material_id > materials.id [delete: restrict]
Ref: quotes.author_id > users.id [delete: set null]

Ref: reading_progress.user_id > users.id [delete: cascade]
Ref: reading_progress.material_id > materials.id [delete: cascade]

Ref: notes.thread_id > threads.id [delete: cascade]
Ref: notes.current_version_id > note_versions.id [delete: set null]
Ref: notes.created_by > users.id [delete: set null]

Ref: note_versions.note_id > notes.id [delete: cascade]
Ref: note_versions.parent_id > note_versions.id [delete: set null]
Ref: note_versions.author_id > users.id [delete: set null]

Ref: tasks.thread_id > threads.id [delete: cascade]
Ref: tasks.created_by > users.id [delete: set null]
